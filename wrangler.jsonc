{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growthbridge",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "binding": "ASSETS",
    // /terma.html is served at /terma; /index.html at /.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker runs first for every request: it 301s www to the apex and
    // adds the security headers, then hands pages to the static assets.
    "run_worker_first": true
  },
  // Both hostnames on this one Worker; wrangler creates their DNS records.
  // www is redirected to the apex in worker/index.ts.
  "routes": [
    { "pattern": "growthbridge.my", "custom_domain": true },
    { "pattern": "www.growthbridge.my", "custom_domain": true }
  ],
  // POST /api/checkout: 10 requests per minute per IP (worker/checkout.ts).
  // namespace_id is any number unique to this account; it is not a secret.
  "ratelimits": [
    { "name": "CHECKOUT_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // Secrets (never in this file): see worker/env.ts and `wrangler secret put`.
  // No duplicate copy of the site on *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
