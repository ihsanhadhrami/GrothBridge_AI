{
  "$schema": "node_modules/wrangler/config-schema.json",
  // www.growthbridge.my -> https://growthbridge.my (301, same path and query).
  // Deploy: npx wrangler deploy -c wrangler.www.jsonc
  "name": "growthbridge-www",
  "main": "worker/www-redirect.ts",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "www.growthbridge.my", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
